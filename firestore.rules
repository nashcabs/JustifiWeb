rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: Firebase Auth uid
    // Fields:
    //   - email: string (required)
    //   - firstName: string (optional)
    //   - middleName: string (optional)
    //   - lastName: string (optional)
    //   - fullName: string (optional)
    //   - role: string (required)
    //   - accountStatus: string (optional)
    //   - isActive: bool (optional)
    //   - profileCompleted: bool (optional)
    //   - birthdate: string (optional)
    //   - studentNumber: string (optional)
    //   - age: string|number (optional)
    //   - sex: string (optional)
    //   - gradeLevel: string (optional)
    //   - section: string (optional)
    //   - schoolName: string (optional)
    //   - adminId: string (optional)
    //   - department: string (optional)
    //   - position: string (optional)
    //   - assignedGradeLevel: string (optional)
    //   - assignedSection: string (optional)
    //   - badges: list (optional)
    //   - quizScores: list (optional)
    //   - progress: list (optional)
    //   - profileImage: map (optional)
    //   - createdAt: timestamp (optional)
    //   - updatedAt: timestamp (optional)
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentUserRole() {
      return isAuthenticated() && exists(userDocPath()) ? get(userDocPath()).data.role : null;
    }

    function isDeveloper() {
      return isAuthenticated() && currentUserRole() == 'developer';
    }

    function isTeacher() {
      return isAuthenticated() && currentUserRole() == 'teacher';
    }

    function isTimestamp(value) {
      return value is timestamp;
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isValidUserBase(data) {
      return hasOnlyAllowedFields(data, [
          'email',
          'firstName',
          'middleName',
          'lastName',
          'fullName',
          'role',
          'schoolId',
          'schoolName',
          'accountStatus',
          'isActive',
          'profileCompleted',
          'birthdate',
          'studentNumber',
          'studentId',
          'age',
          'sex',
          'gradeLevel',
          'sectionId',
          'section',
          'teacherId',
          'adminId',
          'department',
          'position',
          'assignedGradeLevel',
          'assignedSection',
          'assignedGradeLevels',
          'assignedSections',
          'uid',
          'badges',
          'quizScores',
          'progress',
          'profileImage',
          'createdAt',
          'updatedAt'
        ])
        && data.email is string
        && data.email.size() > 0
        && data.role is string
        && data.role in ['student', 'teacher', 'developer', 'nonStudent']
        && (!('firstName' in data) || data.firstName is string)
        && (!('middleName' in data) || data.middleName is string)
        && (!('lastName' in data) || data.lastName is string)
        && (!('fullName' in data) || data.fullName is string)
        && (!('accountStatus' in data) || data.accountStatus is string)
        && (!('isActive' in data) || data.isActive is bool)
        && (!('profileCompleted' in data) || data.profileCompleted is bool)
        && (!('birthdate' in data) || data.birthdate is string)
        && (!('studentNumber' in data) || data.studentNumber is string)
        && (!('age' in data) || data.age is string || data.age is number)
        && (!('sex' in data) || data.sex is string)
        && (!('schoolId' in data) || data.schoolId is string || data.schoolId == null)
        && (!('schoolName' in data) || data.schoolName is string)
        && (!('gradeLevel' in data) || data.gradeLevel is string)
        && (!('sectionId' in data) || data.sectionId is string)
        && (!('section' in data) || data.section is string)
        && (!('teacherId' in data) || data.teacherId is string)
        && (!('adminId' in data) || data.adminId is string)
        && (!('department' in data) || data.department is string)
        && (!('position' in data) || data.position is string)
        && (!('assignedGradeLevel' in data) || data.assignedGradeLevel is string)
        && (!('assignedSection' in data) || data.assignedSection is string)
        && (!('assignedGradeLevels' in data) || data.assignedGradeLevels is list)
        && (!('assignedSections' in data) || data.assignedSections is list)
        && (!('badges' in data) || data.badges is list)
        && (!('quizScores' in data) || data.quizScores is list)
        && (!('progress' in data) || data.progress is list)
        && (!('profileImage' in data) || data.profileImage is map)
        && (!('createdAt' in data) || isTimestamp(data.createdAt))
        && (!('updatedAt' in data) || isTimestamp(data.updatedAt))
        && (!('studentId' in data) || data.studentId is string)
        && (!('uid' in data) || data.uid is string);
    }

    function isValidStudentCreate() {
      return isValidUserBase(request.resource.data)
        && request.resource.data.role == 'student'
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.profileCompleted == false
        && request.resource.data.email == request.auth.token.email;
    }

    function isValidSelfUpdate() {
      return isValidUserBase(request.resource.data)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidTeacherStudentUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gradeLevel', 'section', 'updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.gradeLevel is string
        && request.resource.data.section is string;
    }

    function isValidDeveloperUserUpdate() {
      return request.resource.data.role is string
        && request.resource.data.role in ['student', 'teacher', 'developer']
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('assignedGradeLevel' in request.resource.data) || request.resource.data.assignedGradeLevel is string)
        && (!('assignedSection' in request.resource.data) || request.resource.data.assignedSection is string)
        && (!('assignedSections' in request.resource.data) || request.resource.data.assignedSections is list)
        && (!('isActive' in request.resource.data) || request.resource.data.isActive is bool)
        && (!('updatedAt' in request.resource.data) || isTimestamp(request.resource.data.updatedAt));
    }

    // ===============================================================
    // contactMessages
    // ===============================================================

    match /contactMessages/{messageId} {

      // Public visitors may submit an inquiry.
      allow create: if
        request.resource.data.keys().hasOnly([
          'name',
          'email',
          'subject',
          'message',
          'status',
          'source',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'unread'
        && request.resource.data.source == 'landing-page'
        && request.resource.data.createdAt is timestamp;

      // Only developers can view inquiries.
      allow read: if isDeveloper();

      // Developers can only change inquiry status.
      allow update: if isDeveloper()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['unread', 'read', 'resolved']
        && request.resource.data.updatedAt is timestamp;

      // Keep inquiry history.
      allow delete: if false;
    }

    // ===============================================================
    // users
    // ===============================================================

    match /users/{userId} {
      allow get: if isOwner(userId)
        || isDeveloper()
        || (isTeacher() && resource.data.role == 'student');

      allow list: if isDeveloper()
        || isTeacher();

      allow create: if isAuthenticated()
        && (request.auth.uid == userId || isDeveloper())
        && isValidUserBase(request.resource.data)
        && (isDeveloper() || (
          request.auth.uid == userId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role in ['student', 'nonStudent']
        ));

      allow update: if (isOwner(userId) && (isValidSelfUpdate() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quizScores', 'badges', 'updatedAt'])))
        || (isTeacher() && resource.data.role == 'student' && isValidTeacherStudentUpdate())
        || (isDeveloper() && isValidDeveloperUserUpdate());

      allow delete: if isDeveloper();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}